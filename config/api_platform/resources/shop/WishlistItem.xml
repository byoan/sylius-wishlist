<?xml version="1.0" encoding="UTF-8" ?>

<resources
    xmlns="https://api-platform.com/schema/metadata/resources-3.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://api-platform.com/schema/metadata/resources-3.0 https://api-platform.com/schema/metadata/resources-3.0.xsd"
>
    <resource class="%byoan_sylius_wishlist.model.wishlist_item.class%">
        <operations>
            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_item_get"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/shop/wishlists/{wishlistId}/items/{id}"
            >
                <uriVariables>
                    <uriVariable parameterName="wishlistId" fromClass="%byoan_sylius_wishlist.model.wishlist.class%" toProperty="wishlist" />
                    <uriVariable parameterName="id" fromClass="%byoan_sylius_wishlist.model.wishlist_item.class%" />
                </uriVariables>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist_item:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_item_post"
                class="ApiPlatform\Metadata\Post"
                uriTemplate="/shop/wishlists/{id}/items"
                itemUriTemplate="/shop/wishlists/{wishlistId}/items/{id}"
                read="false"
                input="Byoan\SyliusWishlistPlugin\Api\Input\AddWishlistItem"
                processor="byoan_sylius_wishlist.api.state_processor.add_wishlist_item"
            >
                <uriVariables>
                    <uriVariable parameterName="id" fromClass="%byoan_sylius_wishlist.model.wishlist.class%" />
                </uriVariables>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist_item:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_item_move"
                class="ApiPlatform\Metadata\Post"
                uriTemplate="/shop/wishlists/{wishlistId}/items/{id}/move"
                itemUriTemplate="/shop/wishlists/{wishlistId}/items/{id}"
                status="200"
                read="false"
                input="Byoan\SyliusWishlistPlugin\Api\Input\MoveWishlistItem"
                processor="byoan_sylius_wishlist.api.state_processor.move_wishlist_item"
            >
                <uriVariables>
                    <uriVariable parameterName="wishlistId" fromClass="%byoan_sylius_wishlist.model.wishlist.class%" toProperty="wishlist" />
                    <uriVariable parameterName="id" fromClass="%byoan_sylius_wishlist.model.wishlist_item.class%" />
                </uriVariables>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist_item:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_item_delete"
                class="ApiPlatform\Metadata\Delete"
                uriTemplate="/shop/wishlists/{wishlistId}/items/{id}"
            >
                <uriVariables>
                    <uriVariable parameterName="wishlistId" fromClass="%byoan_sylius_wishlist.model.wishlist.class%" toProperty="wishlist" />
                    <uriVariable parameterName="id" fromClass="%byoan_sylius_wishlist.model.wishlist_item.class%" />
                </uriVariables>
            </operation>
        </operations>
    </resource>
</resources>
