<?xml version="1.0" encoding="UTF-8" ?>

<resources
    xmlns="https://api-platform.com/schema/metadata/resources-3.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://api-platform.com/schema/metadata/resources-3.0 https://api-platform.com/schema/metadata/resources-3.0.xsd"
>
    <resource class="%byoan_sylius_wishlist.model.wishlist.class%">
        <operations>
            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_get_collection"
                class="ApiPlatform\Metadata\GetCollection"
                uriTemplate="/shop/wishlists"
            >
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist:index</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <order>
                    <values>
                        <value name="createdAt">ASC</value>
                    </values>
                </order>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_get"
                class="ApiPlatform\Metadata\Get"
                uriTemplate="/shop/wishlists/{id}"
            >
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_post"
                class="ApiPlatform\Metadata\Post"
                uriTemplate="/shop/wishlists"
                itemUriTemplate="/shop/wishlists/{id}"
                read="true"
                provider="byoan_sylius_wishlist.api.state_provider.new_wishlist"
            >
                <denormalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist:create</value>
                            </values>
                        </value>
                    </values>
                </denormalizationContext>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_patch"
                class="ApiPlatform\Metadata\Patch"
                uriTemplate="/shop/wishlists/{id}"
            >
                <denormalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist:update</value>
                            </values>
                        </value>
                    </values>
                </denormalizationContext>
                <normalizationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>byoan:shop:wishlist:show</value>
                            </values>
                        </value>
                    </values>
                </normalizationContext>
                <validationContext>
                    <values>
                        <value name="groups">
                            <values>
                                <value>sylius</value>
                            </values>
                        </value>
                    </values>
                </validationContext>
            </operation>

            <operation
                name="byoan_sylius_wishlist_api_shop_wishlist_delete"
                class="ApiPlatform\Metadata\Delete"
                uriTemplate="/shop/wishlists/{id}"
                processor="byoan_sylius_wishlist.api.state_processor.delete_wishlist"
            />
        </operations>
    </resource>
</resources>
